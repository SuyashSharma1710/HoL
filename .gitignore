# ==========================================
# Harmony of Life - Production .gitignore
# ==========================================

# --- Dependencies & Package Managers ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# --- Next.js Build & Outputs ---
/.next/
/out/
/build
/dist
.turbo
.swc/

# --- TypeScript Build Cache ---
*.tsbuildinfo
next-env.d.ts

# --- Testing & Coverage ---
/coverage
*.lcov
.nyc_output/
playwright-report/
test-results/

# --- Environment & Secret Files ---
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# --- Debug & Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# --- Vercel & Cloud Deployments ---
.vercel
.serverless/
.amplify

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
[Tt]humbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- Editor & IDE Files ---
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
*~
.eslintcache
*.sublime-workspace
*.sublime-project

# --- Raw Assets & Image Archives ---
raw_images/
raw-assets/

# --- Local Scratch & Temp Directories ---
scratch/
temp/
tmp/
*.tmp
*.bak
*.backup
old-site-comp/

# --- Development Scratch & Extra Notes ---
notes.md
todo.md
TODO.md
scratch.md
*.tmp.md

